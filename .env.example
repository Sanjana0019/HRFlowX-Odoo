# HRFLOWX — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local overrides. Never commit secrets to git repository.

# Application Environment
NEXT_PUBLIC_APP_NAME="HRFlowX"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Supabase Cloud Database Integration
# If left blank, HRFlowX utilizes its reactive unified localStorage state persistence layer.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
